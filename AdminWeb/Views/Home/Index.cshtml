@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-title">Dashboard</div>
<div class="page-subtitle">Tổng quan các chỉ số hoạt động chính của hệ thống VERSA.</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
    <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 24px;">
        <div style="font-size: 24px; color: var(--accent); width: 50px; height: 50px; display: grid; place-items: center; background: rgba(79,139,255,0.1); border-radius: 14px;"><i class="fa-solid fa-map-pin"></i></div>
        <div style="width: 100%;">
            <div style="font-size: 14px; color: var(--text2); margin-bottom: 6px;">Điểm tham quan</div>
            <div style="font-size: 28px; font-weight: 700; color: var(--text); line-height: 1;">@ViewBag.TotalPois</div>
        </div>
    </div>
    
    <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 24px;">
        <div style="font-size: 24px; color: #f59e0b; width: 50px; height: 50px; display: grid; place-items: center; background: rgba(245,158,11,0.1); border-radius: 14px;"><i class="fa-solid fa-route"></i></div>
        <div style="width: 100%;">
            <div style="font-size: 14px; color: var(--text2); margin-bottom: 6px;">Tour du lịch</div>
            <div style="font-size: 28px; font-weight: 700; color: var(--text); line-height: 1;">@ViewBag.TotalTours</div>
        </div>
    </div>
    
    <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 24px;">
        <div style="font-size: 24px; color: #10b981; width: 50px; height: 50px; display: grid; place-items: center; background: rgba(16,185,129,0.1); border-radius: 14px;"><i class="fa-solid fa-headphones"></i></div>
        <div style="width: 100%;">
            <div style="font-size: 14px; color: var(--text2); margin-bottom: 6px;">Tổng lượt phát</div>
            <div style="font-size: 28px; font-weight: 700; color: var(--text); line-height: 1;">@ViewBag.TotalListens</div>
        </div>
    </div>
    
    <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 24px;">
        <div style="font-size: 24px; color: #ef4444; width: 50px; height: 50px; display: grid; place-items: center; background: rgba(239,68,68,0.1); border-radius: 14px;"><i class="fa-solid fa-file-audio"></i></div>
        <div style="width: 100%;">
            <div style="font-size: 14px; color: var(--text2); margin-bottom: 6px;">File audio</div>
            <div style="font-size: 28px; font-weight: 700; color: var(--text); line-height: 1;">@ViewBag.TotalAudioFiles</div>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px; margin-top: 24px;">
    <div class="card">
        <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-line" style="color:var(--accent); margin-right:8px;"></i> Biểu đồ Lượt nghe 7 ngày qua</div></div>
        <div class="card-body" style="height: 320px; padding: 20px;">
            <canvas id="lineChart" style="width: 100%; height: 100%;"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-pie" style="color:#10b981; margin-right:8px;"></i> Tỷ lệ Ngôn ngữ được chọn</div></div>
        <div class="card-body" style="height: 320px; padding: 20px;">
            <canvas id="pieChart" style="width: 100%; height: 100%;"></canvas>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px; margin-top: 24px;">
    <div class="card">
        <div class="card-header"><div class="card-title">Top 5 Điểm Tham Quan Nổi Bật</div></div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 100px; text-align: center;">Xếp hạng</th>
                        <th>Tên địa điểm</th>
                        <th style="text-align: right;">Lượt nghe</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.TopPois != null && ((Dictionary<string, int>)ViewBag.TopPois).Any())
                    {
                        int rank = 1;
                        foreach (var poi in (Dictionary<string, int>)ViewBag.TopPois)
                        {
                            <tr>
                                <td style="text-align: center; font-weight: bold;">
                                    @if (rank == 1) { <span style="font-size: 20px;">🥇</span> }
                                    else if (rank == 2) { <span style="font-size: 20px;">🥈</span> }
                                    else if (rank == 3) { <span style="font-size: 20px;">🥉</span> }
                                    else { <span style="color: var(--text2);">#@rank</span> }
                                </td>
                                <td style="font-weight: 600;">@poi.Key</td>
                                <td style="text-align: right; color: var(--accent); font-weight: bold;">@poi.Value lượt</td>
                            </tr>
                            rank++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" style="text-align: center; padding: 24px; color: var(--text2);">Chưa có dữ liệu lượt nghe.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><div class="card-title">Hoạt động gần đây</div></div>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Điểm tham quan</th>
                        <th>Ngôn ngữ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentActivities != null && ((List<AdminWeb.Models.VisitorPlaybackLog>)ViewBag.RecentActivities).Any())
                    {
                        foreach (var log in (List<AdminWeb.Models.VisitorPlaybackLog>)ViewBag.RecentActivities)
                        {
                            <tr>
                                <td style="font-size: 12px; color: var(--text2);">@log.CreatedAt.ToString("dd/MM HH:mm")</td>
                                <td>@log.PoiName</td>
                                <td><span class="badge blue">@log.LanguageCode.ToUpper()</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" style="text-align: center; padding: 24px; color: var(--text2);">Chưa có hoạt động.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card" style="margin-top: 24px; position: relative;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <div class="card-title"><i class="fa-solid fa-fire" style="color:#ef4444; margin-right:8px;"></i> Bản đồ nhiệt (Heatmap)</div>
        <div class="badge red" style="position: absolute; right: 16px; top: 16px; z-index: 1000;">Tổng số: @ViewBag.TotalListens lượt tương tác</div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div id="heatmap-container" style="height: 400px; width: 100%; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; z-index: 1;"></div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        // KHỞI TẠO BIỂU ĐỒ LINE (CHART.JS)
        var ctxLine = document.getElementById('lineChart').getContext('2d');
        var lineChart = new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Lượt tương tác',
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartData)),
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.15)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#2563eb',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { 
                    y: { beginAtZero: true, ticks: { precision: 0, color: '#8f96b0' }, grid: { color: 'rgba(255,255,255,0.1)' } }, 
                    x: { grid: { display: false }, ticks: { color: '#8f96b0' } } 
                }
            }
        });

        // KHỞI TẠO BIỂU ĐỒ PIE (CHART.JS)
        var ctxPie = document.getElementById('pieChart').getContext('2d');
        var pieChart = new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.PieLabels)),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.PieData)),
                    backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#6366f1'],
                    borderWidth: 2,
                    borderColor: '#13161e'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { 
                        position: 'right',
                        labels: { color: '#e8eaf2' }
                    } 
                },
                cutout: '65%'
            }
        });

        // KHỞI TẠO BẢN ĐỒ HEATMAP (LEAFLET)
        var map = L.map('heatmap-container').setView([10.762622, 106.660172], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        var rawData = @Html.Raw(JsonSerializer.Serialize(ViewBag.HeatmapData));
        if (rawData && rawData.length > 0) {
            var heatData = rawData.map(function(p) { return [p.lat, p.lng, p.intensity]; });
            L.heatLayer(heatData, { radius: 25, blur: 15, maxZoom: 17 }).addTo(map);
            map.fitBounds(new L.LatLngBounds(heatData.map(function(p) { return [p[0], p[1]]; })));
        }
    </script>
}