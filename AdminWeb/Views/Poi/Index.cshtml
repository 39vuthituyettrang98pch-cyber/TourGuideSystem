@model IEnumerable<AdminWeb.Models.Poi>

@{
    ViewData["Title"] = "Quản lý Điểm tham quan (POI)";
}

<div class="page-title">Điểm tham quan (POI)</div>
<div class="page-subtitle">Quản lý danh sách các điểm tham quan trên bản đồ.</div>

<div class="toolbar">
    <div>
        <form asp-action="Index" method="get" style="display: flex; gap: 8px;">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm kiếm tên POI..." style="padding: 6px 12px; width: 250px; font-size: 13px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: var(--text); border-radius: 8px;" />
            <button type="submit" class="btn btn-secondary btn-sm" title="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
            {
                <a asp-action="Index" class="btn btn-secondary btn-sm" title="Xóa tìm kiếm"><i class="fa-solid fa-xmark"></i></a>
            }
        </form>
    </div>
    <div style="display: flex; gap: 8px;">
        <a asp-action="ExportExcel" class="btn btn-secondary btn-sm"><i class="fa-solid fa-file-excel"></i> Xuất Excel</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Thêm POI mới</a>
    </div>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên địa điểm</th>
                <th>Tọa độ</th>
                <th>Bán kính</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var poi in Model)
                {
                    var vi = poi.Translations?.FirstOrDefault(t => t.LanguageCode == "vi");
                    <tr>
                        <td style="font-weight: bold; color: var(--accent);">#@poi.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(poi.CoverImageUrl))
                            {
                                <div style="width: 48px; height: 48px; border-radius: 8px; background-image: url('@poi.CoverImageUrl'); background-size: cover; background-position: center; border: 1px solid rgba(255,255,255,0.1);"></div>
                            }
                            else
                            {
                                <div style="width: 48px; height: 48px; border-radius: 8px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; font-size: 20px; border: 1px solid rgba(255,255,255,0.1);">📍</div>
                            }
                        </td>
                        <td style="font-weight: 600;">@(vi?.Name ?? $"POI #{poi.Id}")</td>
                        <td style="font-family: monospace; font-size: 13px; color: var(--text2);">@poi.Latitude, @poi.Longitude</td>
                        <td>@poi.Radius m</td>
                        <td><span class="badge @(poi.Status == "active" ? "green" : "amber")">@poi.Status</span></td>
                        <td>
                            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                <a asp-action="Edit" asp-route-id="@poi.Id" class="btn btn-sm btn-secondary" title="Sửa POI"><i class="fa-solid fa-pen"></i></a>
                                <a asp-controller="PoiTranslation" asp-action="Index" asp-route-poiId="@poi.Id" class="btn btn-sm btn-secondary" title="Dịch đa ngôn ngữ"><i class="fa-solid fa-language"></i></a>
                                <a asp-controller="Media" asp-action="Index" asp-route-poiId="@poi.Id" class="btn btn-sm btn-secondary" title="Thư viện Media"><i class="fa-solid fa-image"></i></a>
                                <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa điểm tham quan này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@poi.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" style="padding: 6px 10px;" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; padding: 24px; color: var(--text2);">
                        Chưa có điểm tham quan nào trong hệ thống.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <div style="display:flex; justify-content:center; gap:8px; margin-top:20px;">
        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchString="@ViewBag.SearchString" class="btn btn-secondary btn-sm">Trang trước</a>
        }
        <span style="display:inline-flex; align-items:center; padding:0 12px; background:rgba(255,255,255,0.05); border-radius:8px; font-size:14px; font-weight: 600;">
            Trang @ViewBag.CurrentPage / @ViewBag.TotalPages
        </span>
        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchString="@ViewBag.SearchString" class="btn btn-secondary btn-sm">Trang sau</a>
        }
    </div>
}