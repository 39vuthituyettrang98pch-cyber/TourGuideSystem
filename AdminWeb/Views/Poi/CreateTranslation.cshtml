@model AdminWeb.Models.PoiTranslation
@{
    ViewData["Title"] = "Thêm bản dịch ngôn ngữ cho POI";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <form asp-action="CreateTranslation" method="post">
            <input type="hidden" asp-for="PoiId" />
            
            <div class="form-group mb-3">
                <label asp-for="LanguageCode" class="control-label">Ngôn ngữ</label>
                <select asp-for="LanguageCode" class="form-control" required>
                    <option value="">-- Chọn ngôn ngữ --</option>
                    <option value="vi">Tiếng Việt</option>
                    <option value="en">English</option>
                    <option value="fr">Français</option>
                </select>
                <span asp-validation-for="LanguageCode" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Tên POI (dịch)</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FullDescription" class="control-label">Mô tả chi tiết</label>
                <textarea asp-for="FullDescription" class="form-control" rows="4"></textarea>
                <span asp-validation-for="FullDescription" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">Lưu bản dịch</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}