@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Quản lý Media cho POI";
    var poiId = ViewBag.PoiId;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h4 class="fw-bold mb-1 text-white">Quản lý Media cho POI #@poiId</h4>
        <p class="text-secondary small">Thêm, xem hoặc xóa hình ảnh/video của Điểm tham quan.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a>
</div>

<div class="card mb-4" style="background-color: #1a1d24; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 24px;">
    <form asp-action="UploadMedia" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-3 align-items-end">
        <input type="hidden" name="PoiId" value="@poiId" />
        <div class="flex-grow-1" style="max-width: 500px;">
            <label class="form-label text-white" style="font-size: 14px; font-weight: 500;">Tải file mới (Hình ảnh / Video)</label>
            <input type="file" name="file" class="form-control" style="background-color: #0f1115; border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 6px;" accept="image/*,video/*" required />
        </div>
        <button type="submit" class="btn" style="background-color: #3b82f6; color: white; border: none; padding: 9px 20px; border-radius: 6px; font-weight: 500;"><i class="fa-solid fa-cloud-arrow-up me-1"></i> Tải lên</button>
    </form>
</div>

<div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
                        <div class="card h-100 overflow-hidden" style="background-color: #1a1d24; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px;">
                            <div style="height: 160px; background-image: url('@item.FilePath'); background-size: cover; background-position: center; border-bottom: 1px solid rgba(255,255,255,0.05);"></div>
                            <div class="card-body p-3 text-center">
                                <form asp-action="DeleteMedia" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa file này?');">
                                    <input type="hidden" name="PoiId" value="@poiId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="fa-solid fa-trash"></i> Xóa file</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center" style="padding: 60px 20px;">
                    <i class="fa-solid fa-images" style="font-size: 40px; color: var(--text2); opacity: 0.5; margin-bottom: 16px;"></i>
                    <p style="color: var(--text2);">Chưa có media nào trong thư viện. Vui lòng tải lên.</p>
                </div>
            }
</div>