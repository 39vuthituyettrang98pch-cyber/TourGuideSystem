@model AdminWeb.Models.Tour

@{
    ViewData["Title"] = "Bản dịch Tour";
}

<div class="page-title">Quản lý bản dịch - Tour #@Model.Id</div>
<div class="page-subtitle">Quản lý nội dung đa ngôn ngữ cho lộ trình Tour.</div>

<div class="toolbar">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
    </div>
    <div>
        <a asp-action="CreateTranslation" asp-route-tourId="@Model.Id" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Thêm ngôn ngữ mới</a>
    </div>
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Ngôn ngữ</th>
                <th>Tên Tour</th>
                <th>Mô tả</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if(Model.Translations != null && Model.Translations.Any()) {
                foreach (var t in Model.Translations) {
                    <tr>
                        <td><span class="badge blue">@t.LanguageCode.ToUpper()</span></td>
                        <td>@t.Title</td>
                        <td>@(t.Description?.Length > 50 ? t.Description.Substring(0, 50) + "..." : t.Description)</td>
                        <td>
                            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                <a asp-action="EditTranslation" asp-route-id="@t.Id" class="btn btn-sm btn-secondary"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="DeleteTranslation" method="post" style="display:inline;" onsubmit="return confirm('Xóa bản dịch này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            } else {
                <tr><td colspan="4" style="text-align:center;">Chưa có bản dịch nào.</td></tr>
            }
        </tbody>
    </table>
</div>