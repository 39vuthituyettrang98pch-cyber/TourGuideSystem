@model AdminWeb.Models.PoiTranslation

@{
    ViewData["Title"] = "Thêm bản dịch POI";
}

<div class="page-title">Thêm bản dịch Điểm tham quan</div>
<div class="card" style="padding:28px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PoiId" />
        
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">Mã ngôn ngữ</label>
                <input class="form-control" asp-for="LanguageCode" list="lang-list" placeholder="VD: vi, en, fr..." required autocomplete="off" />
                <datalist id="lang-list">
                    <option value="vi">Tiếng Việt</option>
                    <option value="en">Tiếng Anh</option>
                </datalist>
            </div>
            <div class="form-group full">
                <label class="form-label">Tên địa điểm (Theo ngôn ngữ trên)</label>
                <input class="form-control" asp-for="Name" type="text" required />
            </div>
            <div class="form-group full">
                <label class="form-label">Mô tả ngắn</label>
                <textarea class="form-control" asp-for="ShortDescription" rows="2"></textarea>
            </div>
            <div class="form-group full">
                <label class="form-label">Mô tả chi tiết</label>
                <textarea class="form-control" asp-for="FullDescription" rows="4"></textarea>
            </div>
            <div class="form-group full">
                <label class="form-label">File Audio (Thuyết minh)</label>
                <input class="form-control" type="file" name="audioFile" accept="audio/*" />
            </div>
        </div>
        <div style="display:flex;gap:12px; margin-top:24px;">
            <button type="submit" class="btn btn-primary">Lưu bản dịch</button>
            <a asp-action="Index" asp-route-poiId="@Model.PoiId" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>