@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Danh sách bản dịch Danh mục";
    var categoryId = ViewBag.CategoryId;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Bản dịch cho Danh mục ID: @categoryId</h3>
        <div>
            <a asp-action="CreateTranslation" asp-route-categoryId="@categoryId" class="btn btn-success">Thêm ngôn ngữ mới</a>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Mã NN</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-info">@item.LanguageCode</span></td>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-action="EditTranslation" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                                <form asp-action="DeleteTranslation" asp-route-id="@item.Id" method="post" style="display:inline-block;" onsubmit="return confirm('Xóa bản dịch này?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center text-muted">Chưa có bản dịch nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>