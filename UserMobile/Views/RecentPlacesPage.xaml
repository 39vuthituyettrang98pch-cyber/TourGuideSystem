<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UserMobile.Views.RecentPlacesPage"
             Title="Gần đây">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            <Label Text="Địa điểm đã thuyết minh gần đây"
                   FontSize="24"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding RecentPlaces}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding SelectPlaceCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="16"
                               Padding="16"
                               Margin="0,8"
                               HasShadow="True"
                               BackgroundColor="White">
                            <StackLayout Spacing="6">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" FontSize="14" TextColor="#666" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>